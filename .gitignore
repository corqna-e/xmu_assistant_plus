# Local IDE/editor files
/.idea/
/.vscode/
*.swp
*.swo
*.iml

# Kotlin metadata cache（Compose/Kotlin 编译器中间产物）
.kotlin/
*.apk.bak
*.apk
*.aab

# Release 签名密钥：绝不入库（debug.keystore 已入库仅供 debug 变体使用）
*.jks
release*.keystore
upload*.keystore

# Local runtime/config data
.env
.env.*
!.env.example
*.har
/.runtime/
/.agents/
/.superpowers/
*.log

# 内部开发记录（交接/计划/第三方参考），不入库
/docs/
/android/docs/

# Build artifacts
/build/
/dist/
/artifacts/
/.gradle/
/.gradle-user-home/
/android/.gradle/
/android/app/build/

# 本地 .git 备份目录（filter-repo 等操作前的临时备份，禁止入库）
.git-backup-*/

# OS files
Thumbs.db
.DS_Store

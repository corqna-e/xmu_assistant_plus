            <LinearLayout
                android:id="@+id/week_col_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/week_col_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/week_col_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/week_col_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical" />
        </LinearLayout>

        <!--空态 / 未同步：正常渲染时 GONE -->
        <TextView
            android:id="@+id/week_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/widget_secondary_text"
            android:textSize="9dp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>

    <!--课程详情覆盖层。默认 gone，点课程块后由 Provider 填内容并显示。
         点遮罩或「关闭」收起；点卡片本体无动作（避免冒泡把卡片关掉）。
         与「今日课程」组件里的同名区块保持一致，id 相同、版式相同。 -->
    <LinearLayout
        android:id="@+id/detail_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_detail_overlay_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:duplicateParentState="false"
        android:stateListAnimator="@null"
        android:visibility="invisible">

        <LinearLayout
            android:id="@+id/detail_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_detail_card_bg"
            android:orientation="vertical"
            android:duplicateParentState="false"
            android:stateListAnimator="@null"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/widget_primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_secondary_text"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/detail_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_primary_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/detail_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_primary_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/detail_weeks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/widget_primary_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/detail_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/widget_primary_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/detail_teacher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_primary_text"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/detail_open"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:padding="9dp"
                    android:text="打开课表"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:padding="9dp"
                    android:text="关闭"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

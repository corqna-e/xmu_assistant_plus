<?xml version="1.0" encoding="utf-8"?>
<!--今日课程行「时间 / 课名 / 地点」字号整体放大一档；
     明日课程区域与卡片标题、周次、空态、footer 字号一律不动。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView android:includeFontPadding="false"
            android:id="@+id/row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView android:includeFontPadding="false"
            android:id="@+id/row_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/widget_secondary_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!--课程色竖条：与 App 内明日课程卡、周课表组件同一套配色，考试固定暗红。
         必须用 TextView：RemoteViews 不接受 android.view.View。 -->
    <TextView android:id="@+id/row_bar"
        android:layout_width="3dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView android:includeFontPadding="false"
            android:id="@+id/row_course"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_primary_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView android:includeFontPadding="false"
            android:id="@+id/row_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/widget_secondary_text"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>

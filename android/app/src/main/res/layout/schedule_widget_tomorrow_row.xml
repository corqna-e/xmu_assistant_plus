<?xml version="1.0" encoding="utf-8"?>
<!--明日课程的单行，结构与 App 内「明日课程」卡一致：
    左侧起止时间两行、课名与「节次 · 地点」两行，中间一条课程色竖条。
    字号比今日课程行小一档 —— 明日区是预告，不能挤掉今日课程。
    竖条用 TextView 而不是 View：RemoteViews 只接受 @RemoteView 标注的控件，
    android.view.View 不在白名单内，会让整个布局 inflate 失败。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tomorrow_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView android:includeFontPadding="false"
            android:id="@+id/tomorrow_row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView android:includeFontPadding="false"
            android:id="@+id/tomorrow_row_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="9sp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView android:id="@+id/tomorrow_row_bar"
        android:layout_width="2dp"
        android:layout_height="26dp"
        android:layout_marginStart="6dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView android:includeFontPadding="false"
            android:id="@+id/tomorrow_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView android:includeFontPadding="false"
            android:id="@+id/tomorrow_row_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>

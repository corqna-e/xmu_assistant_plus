<?xml version="1.0" encoding="utf-8"?>
<!--宽版今日课程行字号同步放大；明日课程区域不受影响。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="30dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:baselineAligned="false" android:paddingTop="5dp" android:paddingBottom="5dp">
    <TextView android:id="@+id/row_time" android:layout_width="90dp" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/widget_accent" android:includeFontPadding="false" android:maxLines="1" />
    <!--课程色竖条，同一竖条 id 在窄版布局里也有，渲染侧统一写颜色。 -->
    <TextView android:id="@+id/row_bar" android:layout_width="3dp" android:layout_height="30dp"
        android:layout_marginStart="8dp" />
    <TextView android:id="@+id/row_course" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1.2" android:layout_marginStart="8dp" android:textSize="14sp"
        android:textStyle="bold" android:textColor="@color/widget_primary_text" android:includeFontPadding="false"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/row_location" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="8dp" android:textSize="12sp"
        android:textColor="@color/widget_secondary_text" android:includeFontPadding="false"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>

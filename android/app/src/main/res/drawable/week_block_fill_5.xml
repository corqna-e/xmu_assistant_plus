<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="1.5dp" android:insetRight="1.5dp"
    android:insetTop="1dp" android:insetBottom="1dp">
    <shape android:shape="rectangle">
    <solid android:color="#1EC0A6B8" />
    <corners android:radius="4dp" />
    </shape>
</inset>

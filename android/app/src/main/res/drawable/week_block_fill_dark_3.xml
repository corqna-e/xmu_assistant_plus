<?xml version="1.0" encoding="utf-8"?>
<!--周课表小组件：课程块底色 4 号色（灰紫，深色版）。alpha 38，深色卡片上才有足够对比。 -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="1.5dp" android:insetRight="1.5dp"
    android:insetTop="1dp" android:insetBottom="1dp">
    <shape android:shape="rectangle">
    <solid android:color="#389B94B6" />
    <corners android:radius="4dp" />
    </shape>
</inset>

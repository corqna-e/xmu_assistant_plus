<?xml version="1.0" encoding="utf-8"?>
<!--周课表小组件：考试块底色（深色版）。用 App 内深色 examInk #E08282、alpha 0x38，
    与深色模式下考试块的「提亮黄」口径一致。 -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="1.5dp" android:insetRight="1.5dp"
    android:insetTop="1dp" android:insetBottom="1dp">
    <shape android:shape="rectangle">
    <solid android:color="#38E08282" />
    <corners android:radius="4dp" />
    </shape>
</inset>
